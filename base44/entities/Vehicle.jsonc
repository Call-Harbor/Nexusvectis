{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization this vehicle belongs to"
    },
    "name": {
      "type": "string",
      "description": "Vehicle identifier/name"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this vehicle",
      "maxLength": 1000
    },
    "type": {
      "type": "string",
      "enum": [
        "truck",
        "ship",
        "drone",
        "train",
        "aircraft",
        "bus"
      ],
      "description": "Type of transport"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "idle",
        "maintenance",
        "offline"
      ],
      "default": "active"
    },
    "latitude": {
      "type": "number",
      "description": "Current latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Current longitude"
    },
    "heading": {
      "type": "number",
      "description": "Current heading in degrees (0-360)"
    },
    "speed": {
      "type": "number",
      "description": "Current speed in km/h"
    },
    "altitude": {
      "type": "number",
      "description": "Current altitude in meters (for aircraft/drones)"
    },
    "fuel_level": {
      "type": "number",
      "description": "Fuel/battery percentage"
    },
    "cargo_capacity": {
      "type": "number",
      "description": "Total cargo capacity in tons"
    },
    "cargo_used": {
      "type": "number",
      "description": "Currently used cargo in tons"
    },
    "destination": {
      "type": "string",
      "description": "Current destination"
    },
    "eta": {
      "type": "string",
      "format": "date-time",
      "description": "Estimated time of arrival"
    },
    "driver": {
      "type": "string",
      "description": "Driver/operator name"
    },
    "last_maintenance": {
      "type": "string",
      "format": "date",
      "description": "Last maintenance date"
    },
    "next_maintenance": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled maintenance"
    },
    "efficiency_score": {
      "type": "number",
      "description": "AI-calculated efficiency score 0-100"
    },
    "co2_emissions": {
      "type": "number",
      "description": "CO2 emissions in kg"
    },
    "route_id": {
      "type": "string",
      "description": "Current route identifier"
    },
    "resource_id": {
      "type": "string",
      "description": "Current resource (port/warehouse) identifier"
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "AIS",
        "ADS-B",
        "GPS",
        "RFID",
        "LoRa"
      ],
      "description": "Type of tracking signal"
    },
    "signal_strength": {
      "type": "number",
      "description": "Signal strength percentage"
    },
    "mmsi": {
      "type": "string",
      "description": "Maritime Mobile Service Identity for ships"
    },
    "icao": {
      "type": "string",
      "description": "ICAO code for aircraft"
    },
    "callsign": {
      "type": "string",
      "description": "Radio callsign"
    },
    "vessel_class": {
      "type": "string",
      "description": "Ship class (tanker, cargo, container, etc.)"
    },
    "flight_number": {
      "type": "string",
      "description": "Flight number for aircraft"
    }
  },
  "required": [
    "name",
    "type",
    "organization_id"
  ]
}