{
  "name": "GridEvent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "overload",
        "fault",
        "flex_request",
        "maintenance_window",
        "anomaly",
        "dispatch_action",
        "islanding"
      ],
      "description": "Type of grid event"
    },
    "asset_id": {
      "type": "string",
      "description": "Related GridAsset ID"
    },
    "asset_name": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "warning"
    },
    "description": {
      "type": "string"
    },
    "ai_recommendation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ],
      "default": "open"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_module": {
      "type": "string",
      "enum": [
        "port",
        "airport",
        "transit",
        "none"
      ]
    },
    "flex_mw_requested": {
      "type": "number",
      "description": "MW of flexibility requested"
    },
    "flex_duration_min": {
      "type": "number",
      "description": "Duration of flex request in minutes"
    }
  },
  "required": [
    "organization_id",
    "event_type",
    "severity"
  ]
}