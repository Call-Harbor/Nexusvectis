{
  "name": "Asset",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization this asset belongs to"
    },
    "asset_number": {
      "type": "string",
      "description": "Unique asset identifier"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "trailer",
        "container",
        "pallet",
        "forklift",
        "scanner",
        "other"
      ],
      "description": "Type of asset"
    },
    "name": {
      "type": "string",
      "description": "Asset name/description"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "in_use",
        "maintenance",
        "retired"
      ],
      "default": "available",
      "description": "Asset status"
    },
    "assigned_to_vehicle_id": {
      "type": "string",
      "description": "Currently assigned to vehicle"
    },
    "assigned_to_driver_id": {
      "type": "string",
      "description": "Currently assigned to driver"
    },
    "location": {
      "type": "string",
      "description": "Current location"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Purchase date"
    },
    "purchase_cost": {
      "type": "number",
      "description": "Purchase cost"
    },
    "manufacturer": {
      "type": "string",
      "description": "Manufacturer"
    },
    "model": {
      "type": "string",
      "description": "Model"
    },
    "serial_number": {
      "type": "string",
      "description": "Serial number"
    },
    "specifications": {
      "type": "object",
      "additionalProperties": true,
      "description": "Technical specifications"
    },
    "last_maintenance_date": {
      "type": "string",
      "format": "date",
      "description": "Last maintenance date"
    },
    "next_maintenance_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled maintenance"
    },
    "maintenance_interval_days": {
      "type": "number",
      "default": 90,
      "description": "Maintenance interval in days"
    },
    "total_usage_hours": {
      "type": "number",
      "default": 0,
      "description": "Total hours used"
    },
    "utilization_rate": {
      "type": "number",
      "description": "Utilization rate percentage"
    },
    "depreciation_rate": {
      "type": "number",
      "description": "Annual depreciation rate"
    },
    "current_value": {
      "type": "number",
      "description": "Current estimated value"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "organization_id",
    "asset_number",
    "asset_type",
    "name"
  ]
}