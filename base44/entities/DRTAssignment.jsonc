{
  "name": "DRTAssignment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization"
    },
    "drt_vehicle_id": {
      "type": "string",
      "description": "DRT vehicle assigned"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this DRT assignment",
      "maxLength": 1000
    },
    "route": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stop_order": {
            "type": "number"
          },
          "request_id": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          },
          "arrival_time": {
            "type": "string"
          }
        }
      },
      "description": "Optimized route stops"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "completed"
      ],
      "default": "planning"
    },
    "requests_count": {
      "type": "number",
      "description": "Number of requests in route"
    },
    "total_passengers": {
      "type": "number",
      "description": "Total passengers in assignment"
    },
    "estimated_completion": {
      "type": "string",
      "format": "date-time"
    },
    "actual_completion": {
      "type": "string",
      "format": "date-time"
    },
    "efficiency_score": {
      "type": "number",
      "description": "Route efficiency 0-100"
    }
  },
  "required": [
    "organization_id",
    "drt_vehicle_id",
    "route",
    "status"
  ]
}