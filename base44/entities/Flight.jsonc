{
  "name": "Flight",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "flight_number": {
      "type": "string",
      "description": "e.g. SK204"
    },
    "airline": {
      "type": "string"
    },
    "airline_iata": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "description": "IATA origin"
    },
    "destination": {
      "type": "string",
      "description": "IATA destination"
    },
    "aircraft_type": {
      "type": "string"
    },
    "registration": {
      "type": "string"
    },
    "gate_id": {
      "type": "string"
    },
    "stand": {
      "type": "string"
    },
    "terminal": {
      "type": "string"
    },
    "flight_type": {
      "type": "string",
      "enum": [
        "arrival",
        "departure",
        "turnaround"
      ],
      "default": "turnaround"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_time": {
      "type": "string",
      "format": "date-time"
    },
    "actual_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "boarding",
        "final_call",
        "departed",
        "airborne",
        "approaching",
        "landed",
        "at_gate",
        "delayed",
        "cancelled",
        "diverted"
      ],
      "default": "scheduled"
    },
    "delay_minutes": {
      "type": "number",
      "default": 0
    },
    "delay_reason": {
      "type": "string"
    },
    "pax_total": {
      "type": "number",
      "default": 0
    },
    "pax_boarded": {
      "type": "number",
      "default": 0
    },
    "pax_connections": {
      "type": "number",
      "default": 0
    },
    "bags_total": {
      "type": "number",
      "default": 0
    },
    "bags_loaded": {
      "type": "number",
      "default": 0
    },
    "bags_offloaded": {
      "type": "number",
      "default": 0
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },
    "schengen": {
      "type": "boolean",
      "default": true
    },
    "turnaround_status": {
      "type": "string",
      "enum": [
        "pending",
        "deboarding",
        "cleaning",
        "catering",
        "fueling",
        "baggage_in",
        "baggage_out",
        "boarding",
        "ready",
        "completed"
      ],
      "default": "pending"
    },
    "ground_time_minutes": {
      "type": "number"
    },
    "target_ground_minutes": {
      "type": "number"
    },
    "co2_kg": {
      "type": "number",
      "default": 0
    },
    "fuel_uplift_kg": {
      "type": "number",
      "default": 0
    },
    "ai_risk_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 disruption risk"
    }
  },
  "required": [
    "flight_number",
    "organization_id"
  ]
}