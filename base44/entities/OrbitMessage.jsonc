{
  "name": "OrbitMessage",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization this message belongs to"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of sender"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "driver",
        "coordinator"
      ],
      "description": "Role of sender"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of recipient"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "description": {
      "type": "string",
      "description": "Optional description or context for this message",
      "maxLength": 1000
    },
    "route_id": {
      "type": "string",
      "description": "Related route ID if applicable"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Related vehicle ID if applicable"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "route_update",
        "alert",
        "confirmation"
      ],
      "default": "text",
      "description": "Type of message"
    }
  },
  "required": [
    "organization_id",
    "sender_email",
    "sender_name",
    "sender_role",
    "message"
  ]
}