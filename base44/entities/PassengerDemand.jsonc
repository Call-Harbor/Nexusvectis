{
  "name": "PassengerDemand",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization tracking this demand"
    },
    "stop_id": {
      "type": "string",
      "description": "Bus stop ID"
    },
    "line_id": {
      "type": "string",
      "description": "Bus line ID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When demand was recorded"
    },
    "passenger_count": {
      "type": "number",
      "description": "Number of passengers"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this passenger demand record",
      "maxLength": 1000
    },
    "source": {
      "type": "string",
      "enum": [
        "counter",
        "ticket_system",
        "app_checkin",
        "telecom_data",
        "event_prediction"
      ],
      "description": "Data source"
    },
    "segment_type": {
      "type": "string",
      "enum": [
        "commuter",
        "school",
        "elderly",
        "tourist",
        "event"
      ],
      "description": "Passenger segment"
    },
    "day_type": {
      "type": "string",
      "enum": [
        "weekday",
        "weekend",
        "holiday"
      ]
    },
    "hour_of_day": {
      "type": "number",
      "description": "Hour 0-23"
    }
  },
  "required": [
    "organization_id",
    "timestamp",
    "passenger_count"
  ]
}