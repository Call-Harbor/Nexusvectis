{
  "name": "InvoiceSettings",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description of these invoice settings",
      "maxLength": 1000
    },
    "company_name": {
      "type": "string",
      "description": "Company legal name",
      "default": "NexusVectis ApS"
    },
    "vat_number": {
      "type": "string",
      "description": "VAT registration number",
      "default": "DK12345678"
    },
    "company_address": {
      "type": "string",
      "description": "Full company address",
      "default": "Vesterbrogade 123, 1620 K\u00f8benhavn V, Denmark"
    },
    "company_country": {
      "type": "string",
      "description": "Company country",
      "default": "Denmark"
    },
    "company_email": {
      "type": "string",
      "description": "Company contact email"
    },
    "company_phone": {
      "type": "string",
      "description": "Company phone number"
    },
    "bank_account": {
      "type": "string",
      "description": "Bank account number (IBAN)"
    },
    "bank_swift": {
      "type": "string",
      "description": "SWIFT/BIC code"
    },
    "company_registration": {
      "type": "string",
      "description": "Company registration number (CVR in Denmark)"
    },
    "accounting_account": {
      "type": "string",
      "description": "Standard kontonummer til bogf\u00f8ring"
    },
    "cost_center": {
      "type": "string",
      "description": "Standard omkostningscenter"
    },
    "project_number": {
      "type": "string",
      "description": "Standard projektnummer"
    },
    "reference_number": {
      "type": "string",
      "description": "Standard reference/bilagsnummer"
    },
    "accounting_notes": {
      "type": "string",
      "description": "Standard interne noter til bogf\u00f8ring"
    },
    "payment_instructions": {
      "type": "string",
      "description": "Standard betalingsinstruktioner"
    },
    "default_payment_terms": {
      "type": "string",
      "description": "Standard betalingsbetingelser (f.eks. Net 14 dage)"
    },
    "invoice_footer_text": {
      "type": "string",
      "description": "Standard footer tekst p\u00e5 fakturaer"
    },
    "tax_registration_number": {
      "type": "string",
      "description": "Momsregistreringsnummer (hvis anderledes end VAT)"
    },
    "department": {
      "type": "string",
      "description": "Standard afdeling"
    },
    "default_currency": {
      "type": "string",
      "description": "Standard valuta (EUR, DKK, USD, etc.)",
      "default": "EUR"
    },
    "invoice_prefix": {
      "type": "string",
      "description": "Pr\u00e6fiks til fakturanumre (f.eks. INV-)"
    },
    "logo_url": {
      "type": "string",
      "description": "URL til firma logo"
    },
    "website": {
      "type": "string",
      "description": "Firma hjemmeside"
    },
    "custom_field_1_label": {
      "type": "string",
      "description": "Label for tilpasset felt 1"
    },
    "custom_field_2_label": {
      "type": "string",
      "description": "Label for tilpasset felt 2"
    },
    "custom_field_3_label": {
      "type": "string",
      "description": "Label for tilpasset felt 3"
    }
  },
  "required": [
    "company_name",
    "vat_number",
    "company_address",
    "company_country"
  ]
}