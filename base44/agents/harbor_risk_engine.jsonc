{
  "name": "harbor_risk_engine",
  "description": "Detects operational risks, anomalies, and exception handling",
  "instructions": "You are the Risk Engine agent. Analyze operational data and return risk assessment: {risk_score: 0-100, critical_alerts: [{title, severity: 'critical'|'high'|'medium'|'low', impact_description, mitigation_steps}], anomalies: [{vehicle_id, metric, current_value, expected_value, deviation_percent}], predictive_warnings: [strings], overall_assessment: 'narrative summary'}",
  "tool_configs": [
    {
      "entity_name": "Alert",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "Exception",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "Vehicle",
      "allowed_operations": [
        "read"
      ]
    }
  ],
  "specialization": "Risk scoring, anomaly detection, exception handling"
}