    {
      "entity_name": "Document",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "SecurityAudit",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "Vehicle",
      "allowed_operations": [
        "read"
      ]
    }
  ],
  "specialization": "Regulatory compliance, audit trails, certifications"
}